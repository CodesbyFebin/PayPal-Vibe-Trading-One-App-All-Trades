# Server-side values. Keep .env private.
# Braintree is the primary checkout demo and is Sandbox-only.
BRAINTREE_ENV=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Choose one AI provider. Gemini takes priority if both keys are set.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional custom OpenAI-compatible provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional server-side owner PIN for exact trade approvals and kill-switch control (minimum 12 chars).
# Never expose this value to the browser or commit a real value.
OWNER_PIN=
# Optional origin for sandbox return links. Local runs default to localhost:3000.
APP_URL=http://localhost:3000
